generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  customer
  partner
  admin

  @@map("user_role")
}

enum SegmentType {
  micro_retail
  professional_office
  multi_site
  small_manufacturer

  @@map("segment_type")
}

enum ChannelType {
  web
  voice
  whatsapp

  @@map("channel_type")
}

enum MsgRole {
  user
  assistant
  system

  @@map("msg_role")
}

enum ProductCategory {
  broadband
  sim
  cloud_email
  cloud_storage
  cybersecurity
  cctv
  pos
  whatsapp_api
  iot
  erp
  other

  @@map("product_category")
}

enum DepKind {
  requires
  excludes

  @@map("dep_kind")
}

enum RecStatus {
  proposed
  viewed
  accepted
  rejected
  expired

  @@map("rec_status")
}

enum QuoteStatus {
  draft
  presented
  accepted
  abandoned
  expired

  @@map("quote_status")
}

enum OrderStatus {
  placed
  kyc_pending
  kyc_verified
  provisioning
  installation_scheduled
  activated
  on_hold
  cancelled

  @@map("order_status")
}

enum KycStatus {
  not_started
  submitted
  in_review
  verified
  issues_found
  rejected

  @@map("kyc_status")
}

enum DocType {
  gst_certificate
  udyam_registration
  signatory_id
  address_proof

  @@map("doc_type")
}

enum CheckStatus {
  pass
  warn
  fail

  @@map("check_status")
}

enum RiskLevel {
  low
  medium
  high

  @@map("risk_level")
}

enum LeadStage {
  lead
  needs_assessment
  quote_presented
  quote_accepted
  kyc
  order_placed
  activated
  dropped

  @@map("lead_stage")
}

enum HandoffStatus {
  open
  assigned
  in_progress
  resolved

  @@map("handoff_status")
}

enum EventStage {
  order_placed
  kyc_submitted
  kyc_verified
  service_provisioning
  installation_scheduled
  activated

  @@map("event_stage")
}

enum StageState {
  done
  in_progress
  pending
  blocked

  @@map("stage_state")
}

// ---------- 1. IDENTITY ---------------------------------------------
model Profile {
  id                 String   @id @db.Uuid // = auth.users.id
  role               UserRole @default(customer)
  fullName           String?  @map("full_name")
  phone              String?  @unique
  preferredLanguage  String   @default("en") @map("preferred_language")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  partner       Partner?
  businesses    Business[]
  conversations Conversation[]
  consents      Consent[]
  orders        Order[]
  reviewedKyc   KycCase[]
  auditLogs     AuditLog[]

  @@map("profiles")
}

model Partner {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId  String?  @unique @map("profile_id") @db.Uuid
  name       String
  region     String?
  cityTiers  Int[]    @default([1, 2, 3]) @map("city_tiers") @db.SmallInt
  capacity   Int      @default(20)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile  Profile?  @relation(fields: [profileId], references: [id], onDelete: SetNull)
  orders   Order[]
  leads    Lead[]
  handoffs Handoff[]

  @@map("partners")
}

// ---------- 2. PRODUCT CATALOGUE ------------------------------------
model Product {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String          @unique
  legacyCode       String?         @map("legacy_code")
  name             String
  category         ProductCategory
  description      String?
  monthlyPrice     Decimal         @map("monthly_price") @db.Decimal(10, 2)
  setupFee         Decimal         @default(0) @map("setup_fee") @db.Decimal(10, 2)
  contractMonths   Int             @default(12) @map("contract_months")
  isAddon          Boolean         @default(false) @map("is_addon")
  minEmployees     Int?            @default(1) @map("min_employees")
  maxEmployees     Int?            @map("max_employees")
  allowedCityTiers Int[]           @default([1, 2, 3]) @map("allowed_city_tiers") @db.SmallInt
  requiresGstin    Boolean         @default(false) @map("requires_gstin")
  isActive         Boolean         @default(true) @map("is_active")

  dependencies      ProductDependency[] @relation("ProductDeps")
  dependedOnBy      ProductDependency[] @relation("RelatedProductDeps")
  bundleItems       BundleItem[]
  eligibilityRules  EligibilityRule[]
  quoteItems        QuoteItem[]
  orderItems        OrderItem[]

  @@map("products")
}

model ProductDependency {
  productId        String  @map("product_id") @db.Uuid
  relatedProductId String  @map("related_product_id") @db.Uuid
  kind             DepKind

  product        Product @relation("ProductDeps", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct Product @relation("RelatedProductDeps", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@id([productId, relatedProductId, kind])
  @@map("product_dependencies")
}

model Bundle {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String       @unique
  name          String
  targetSegment SegmentType? @map("target_segment")
  description   String?
  discountPct   Decimal?     @default(0) @map("discount_pct") @db.Decimal(5, 2)
  isActive      Boolean      @default(true) @map("is_active")

  items              BundleItem[]
  eligibilityRules   EligibilityRule[]
  recommendations    Recommendation[]
  recoveryOriginal   RecoveryOffer[] @relation("RecoveryOriginalBundle")
  recoveryAlt        RecoveryOffer[] @relation("RecoveryAltBundle")

  @@map("bundles")
}

model BundleItem {
  bundleId   String  @map("bundle_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  quantity   Int     @default(1)
  isOptional Boolean @default(false) @map("is_optional")

  bundle  Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([bundleId, productId])
  @@map("bundle_items")
}

model EligibilityRule {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String? @map("product_id") @db.Uuid
  bundleId  String? @map("bundle_id") @db.Uuid
  ruleType  String  @map("rule_type")
  rule      Json

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  bundle  Bundle?  @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@map("eligibility_rules")
}

// ---------- 3. BUSINESS ---------------------------------------------
model Business {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId      String       @map("owner_id") @db.Uuid
  name         String?
  businessType String?      @map("business_type")
  segment      SegmentType?
  employees    Int?
  locations    Int?         @default(1)
  address      String?
  city         String?
  state        String?
  pincode      String?
  cityTier     Int?         @map("city_tier") @db.SmallInt
  gstin        String?
  udyamNo      String?      @map("udyam_no")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  owner            Profile           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  businessProfiles BusinessProfile[]
  conversations    Conversation[]
  recommendations  Recommendation[]
  quotes           Quote[]
  orders           Order[]
  kycCases         KycCase[]
  consents         Consent[]
  leads            Lead[]

  @@index([ownerId])
  @@map("businesses")
}

model BusinessProfile {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId       String   @map("business_id") @db.Uuid
  conversationId   String?  @map("conversation_id") @db.Uuid
  needs            String[] @default([])
  hasBroadband     Boolean? @map("has_broadband")
  budgetMonthly    Decimal? @map("budget_monthly") @db.Decimal(10, 2)
  structured       Json     @default("{}")
  digitalReadiness Json?    @map("digital_readiness")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@map("business_profiles")
}

// ---------- 4. AI ADVISOR -------------------------------------------
model Conversation {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String?     @map("user_id") @db.Uuid
  businessId     String?     @map("business_id") @db.Uuid
  channel        ChannelType @default(web)
  language       String      @default("en")
  status         String      @default("active")
  aiConfidence   Decimal?    @map("ai_confidence") @db.Decimal(4, 3)
  completionPct  Int?        @default(0) @map("completion_pct")
  handoffNeeded  Boolean     @default(false) @map("handoff_needed")
  startedAt      DateTime    @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt        DateTime?   @map("ended_at") @db.Timestamptz(6)

  user             Profile?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  business         Business?         @relation(fields: [businessId], references: [id], onDelete: SetNull)
  messages         Message[]
  businessProfiles BusinessProfile[]
  recommendations  Recommendation[]
  leads            Lead[]
  handoffs         Handoff[]

  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  role           MsgRole
  content        String
  inputMode      String?  @default("text") @map("input_mode")
  audioPath      String?  @map("audio_path")
  extracted      Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ---------- 5. RECOMMENDATION ---------------------------------------
model Recommendation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId  String?   @map("conversation_id") @db.Uuid
  businessId      String    @map("business_id") @db.Uuid
  bundleId        String    @map("bundle_id") @db.Uuid
  rank            Int       @default(1) @db.SmallInt
  matchScore      Decimal?  @map("match_score") @db.Decimal(5, 2)
  scoreBreakdown  Json?     @map("score_breakdown")
  explanation     String?
  status          RecStatus @default(proposed)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bundle       Bundle        @relation(fields: [bundleId], references: [id])
  quotes       Quote[]

  @@index([businessId])
  @@map("recommendations")
}

// ---------- 6. QUOTE & ORDER ----------------------------------------
model Quote {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId       String      @map("business_id") @db.Uuid
  recommendationId String?     @map("recommendation_id") @db.Uuid
  status           QuoteStatus @default(draft)
  monthlyTotal     Decimal     @default(0) @map("monthly_total") @db.Decimal(10, 2)
  setupTotal       Decimal     @default(0) @map("setup_total") @db.Decimal(10, 2)
  contractMonths   Int?        @map("contract_months")
  validUntil       DateTime?   @map("valid_until") @db.Timestamptz(6)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recommendation Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  items          QuoteItem[]
  orders         Order[]

  @@index([businessId])
  @@map("quotes")
}

model QuoteItem {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId    String  @map("quote_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  quantity   Int     @default(1)
  unitPrice  Decimal @map("unit_price") @db.Decimal(10, 2)
  setupFee   Decimal @default(0) @map("setup_fee") @db.Decimal(10, 2)
  isAddon    Boolean @default(false) @map("is_addon")
  isSelected Boolean @default(true) @map("is_selected")

  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("quote_items")
}

model Consent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  businessId    String?   @map("business_id") @db.Uuid
  purpose       String
  policyVersion String    @map("policy_version")
  granted       Boolean
  grantedAt     DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  ipAddress     String?   @map("ip_address") @db.Inet

  user     Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@map("consents")
}

model Order {
  id                      String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNo                 String      @unique @default(cuid()) @map("order_no") // SQL generates 'UD-YYMMDD-xxxxxx'; override in app if you want that format
  quoteId                 String      @map("quote_id") @db.Uuid
  businessId              String      @map("business_id") @db.Uuid
  userId                  String      @map("user_id") @db.Uuid
  consentId               String?     @map("consent_id") @db.Uuid
  partnerId               String?     @map("partner_id") @db.Uuid
  status                  OrderStatus @default(placed)
  monthlyTotal            Decimal     @map("monthly_total") @db.Decimal(10, 2)
  setupTotal              Decimal     @default(0) @map("setup_total") @db.Decimal(10, 2)
  contractMonths          Int?        @map("contract_months")
  predictedActivationDays Decimal?    @map("predicted_activation_days") @db.Decimal(4, 1)
  predictionConfidence    String?     @map("prediction_confidence")
  expectedActivationAt    DateTime?   @map("expected_activation_at") @db.Timestamptz(6)
  activatedAt             DateTime?   @map("activated_at") @db.Timestamptz(6)
  placedAt                DateTime    @default(now()) @map("placed_at") @db.Timestamptz(6)

  quote       Quote                    @relation(fields: [quoteId], references: [id])
  business    Business                 @relation(fields: [businessId], references: [id])
  user        Profile                  @relation(fields: [userId], references: [id])
  consent     Consent?                 @relation(fields: [consentId], references: [id])
  partner     Partner?                 @relation(fields: [partnerId], references: [id])
  items       OrderItem[]
  kycCase     KycCase?
  events      ActivationEvent[]
  appointments InstallationAppointment[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int     @default(1)
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  setupFee  Decimal @default(0) @map("setup_fee") @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// ---------- 7. KYC ---------------------------------------------------
model KycCase {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String?    @unique @map("order_id") @db.Uuid
  businessId  String     @map("business_id") @db.Uuid
  status      KycStatus  @default(not_started)
  trustScore  Int?       @map("trust_score") @db.SmallInt
  risk        RiskLevel?
  submittedAt DateTime?  @map("submitted_at") @db.Timestamptz(6)
  verifiedAt  DateTime?  @map("verified_at") @db.Timestamptz(6)
  reviewerId  String?    @map("reviewer_id") @db.Uuid

  order     Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  business  Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reviewer  Profile?      @relation(fields: [reviewerId], references: [id])
  documents KycDocument[]
  checks    KycCheck[]

  @@map("kyc_cases")
}

model KycDocument {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kycCaseId     String    @map("kyc_case_id") @db.Uuid
  docType       DocType   @map("doc_type")
  storagePath   String    @map("storage_path")
  mimeType      String?   @map("mime_type")
  status        String    @default("uploaded")
  ocrConfidence Decimal?  @map("ocr_confidence") @db.Decimal(4, 3)
  extracted     Json?
  uploadedAt    DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  deleteAfter   DateTime? @map("delete_after") @db.Timestamptz(6)

  kycCase KycCase @relation(fields: [kycCaseId], references: [id], onDelete: Cascade)

  @@index([kycCaseId])
  @@map("kyc_documents")
}

model KycCheck {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kycCaseId String      @map("kyc_case_id") @db.Uuid
  checkType String      @map("check_type")
  status    CheckStatus
  detail    String?
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  kycCase KycCase @relation(fields: [kycCaseId], references: [id], onDelete: Cascade)

  @@index([kycCaseId])
  @@map("kyc_checks")
}

model MockGstinRegistry {
  gstin        String    @id
  legalName    String    @map("legal_name")
  tradeName    String?   @map("trade_name")
  address      String?
  state        String?
  status       String
  registeredOn DateTime? @map("registered_on") @db.Date

  @@map("mock_gstin_registry")
}

model MockUdyamRegistry {
  udyamNo        String  @id @map("udyam_no")
  enterpriseName String  @map("enterprise_name")
  ownerName      String? @map("owner_name")
  address        String?
  activity       String?
  status         String  @default("active")

  @@map("mock_udyam_registry")
}

// ---------- 8. ACTIVATION TRACKER -----------------------------------
model ActivationEvent {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId            String     @map("order_id") @db.Uuid
  stage              EventStage
  state              StageState @default(pending)
  message            String?
  nextStep           String?    @map("next_step")
  userActionRequired Boolean    @default(false) @map("user_action_required")
  expectedAt         DateTime?  @map("expected_at") @db.Timestamptz(6)
  completedAt        DateTime?  @map("completed_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, stage])
  @@index([orderId])
  @@map("activation_events")
}

model InstallationAppointment {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String    @map("order_id") @db.Uuid
  scheduledFor DateTime  @map("scheduled_for") @db.Timestamptz(6)
  windowEnd    DateTime? @map("window_end") @db.Timestamptz(6)
  technician   String?
  status       String    @default("scheduled")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("installation_appointments")
}

// ---------- 9. LEADS, HANDOFF, PROPENSITY ---------------------------
model Lead {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId        String?    @map("business_id") @db.Uuid
  conversationId    String?    @map("conversation_id") @db.Uuid
  source            String?
  stage             LeadStage  @default(lead)
  dropOffStage      LeadStage? @map("drop_off_stage")
  dropOffReason     String?    @map("drop_off_reason")
  propensityScore   Decimal?   @map("propensity_score") @db.Decimal(5, 2)
  assignedPartnerId String?    @map("assigned_partner_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business        Business?       @relation(fields: [businessId], references: [id], onDelete: SetNull)
  conversation    Conversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assignedPartner Partner?        @relation(fields: [assignedPartnerId], references: [id])
  events          LeadEvent[]
  scores          PropensityScore[]
  handoffs        Handoff[]
  recoveryOffers  RecoveryOffer[]

  @@index([stage])
  @@index([assignedPartnerId])
  @@map("leads")
}

model LeadEvent {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId     String    @map("lead_id") @db.Uuid
  stage      LeadStage
  metadata   Json?
  occurredAt DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_events")
}

model PropensityScore {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId       String   @map("lead_id") @db.Uuid
  score        Decimal  @db.Decimal(5, 2)
  modelVersion String?  @map("model_version")
  features     Json?
  computedAt   DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("propensity_scores")
}

model Handoff {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId         String        @map("lead_id") @db.Uuid
  conversationId String?       @map("conversation_id") @db.Uuid
  partnerId      String?       @map("partner_id") @db.Uuid
  reason         String
  aiCompletionPct Int?         @map("ai_completion_pct")
  priority       Int?          @default(3) @db.SmallInt
  status         HandoffStatus @default(open)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt     DateTime?     @map("resolved_at") @db.Timestamptz(6)

  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  partner      Partner?      @relation(fields: [partnerId], references: [id])

  @@index([status, priority])
  @@map("handoffs")
}

model RecoveryOffer {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId           String   @map("lead_id") @db.Uuid
  originalBundleId String?  @map("original_bundle_id") @db.Uuid
  altBundleId      String?  @map("alt_bundle_id") @db.Uuid
  message          String?
  status           String   @default("sent")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lead           Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  originalBundle Bundle? @relation("RecoveryOriginalBundle", fields: [originalBundleId], references: [id])
  altBundle      Bundle? @relation("RecoveryAltBundle", fields: [altBundleId], references: [id])

  @@map("recovery_offers")
}

// ---------- 10. AUDIT -----------------------------------------------
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id") @db.Uuid
  metadata  Json?
